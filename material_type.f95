module material_type
  use random
  use tape_type
  implicit none

  type, abstract :: material
     integer :: n
     real(kind(1.d0)) :: density
     real(kind(1.d0)), allocatable :: mu(:, :)
     type(tape) :: endf
   contains
     procedure(create_intf), deferred :: create
  end type material

  abstract interface
     subroutine create_intf(this)
       import material
       class(material), intent(inout) :: this
     end subroutine create_intf
  end interface

  type, extends(material) :: steel
   contains
     procedure, pass :: create => create_steel
  end type steel

  type, extends(material) :: iodine
   contains
     procedure, pass :: create => create_iodine
  end type iodine

  type, extends(material) :: sodium
   contains
     procedure, pass :: create => create_sodium
  end type sodium

  type, extends(material) :: titanium
   contains
     procedure, pass :: create => create_titanium
  end type titanium

  type, extends(material) :: nitrogen
   contains
     procedure, pass :: create => create_nitrogen
  end type nitrogen

  type, extends(material) :: hydrogen
   contains
     procedure, pass :: create => create_hydrogen
  end type hydrogen

  type, extends(material) :: oxygen
   contains
     procedure, pass :: create => create_oxygen
  end type oxygen

