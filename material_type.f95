module material_type
  use random
  implicit none

  type, abstract :: material
     real :: density
   contains
     procedure(create_intf), deferred :: create
  end type material

  abstract interface
     subroutine create_intf(this)
       import material
       class(material), intent(inout) :: this
       real :: pdf1
     end subroutine create_intf
  end interface

  type, extends(material) :: steel
     real, dimension(3, 37) :: mu
   contains
     procedure, pass :: create => create_steel
  end type steel

  type, extends(material) :: iodine
     real, dimension(3, 48) :: mu
   contains
     procedure, pass :: create => create_iodine
  end type iodine

contains

